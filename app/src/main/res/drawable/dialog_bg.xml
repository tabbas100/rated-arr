<?xml version="1.0" encoding="utf-8"?>
<!-- The delete question's card: raised paper in a thick ink frame, on a hard ink shadow down and right. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="6dp" android:top="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/text" />
        </shape>
    </item>
    <item android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_raised" />
            <stroke android:width="3dp" android:color="@color/text" />
        </shape>
    </item>
</layer-list>
