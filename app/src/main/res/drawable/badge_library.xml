<?xml version="1.0" encoding="utf-8"?>
<!-- The "In library" sticker: a red label with a hard ink shadow, slapped on at an angle (rotation in card_poster). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="2dp" android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/text" />
        </shape>
    </item>
    <item android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/focus" />
        </shape>
    </item>
</layer-list>
