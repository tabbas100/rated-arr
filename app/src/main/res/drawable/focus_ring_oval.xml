<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn over a cast photo: an ink ring, and a red one around it when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="4dp" android:color="@color/focus" />
                </shape>
            </item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
                <shape android:shape="oval">
                    <stroke android:width="2dp" android:color="@color/text" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="@color/text" />
        </shape>
    </item>
</selector>
