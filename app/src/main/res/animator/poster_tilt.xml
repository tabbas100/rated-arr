<?xml version="1.0" encoding="utf-8"?>
<!-- A focused poster tilts like a poster slapped on a wall; it follows the card's focus (duplicateParentState). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <objectAnimator android:duration="160" android:interpolator="@android:interpolator/decelerate_quad"
            android:propertyName="rotation" android:valueTo="-2" android:valueType="floatType" />
    </item>
    <item>
        <objectAnimator android:duration="160" android:interpolator="@android:interpolator/decelerate_quad"
            android:propertyName="rotation" android:valueTo="0" android:valueType="floatType" />
    </item>
</selector>
