<?xml version="1.0" encoding="utf-8"?>
<!-- The episode picker: seasons (and All episodes) on the left, the focused season's episodes on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="56dp"
    android:paddingTop="36dp"
    android:paddingEnd="56dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/title"
        style="@style/Text.Title"
        android:singleLine="true"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/subtitle"
        style="@style/Text"
        android:layout_marginTop="4dp"
        android:text="@string/pick_subtitle"
        android:textColor="@color/text_dim" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <ScrollView
                android:layout_width="300dp"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/seasons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="28dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/episodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/text_dim" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/summary"
            style="@style/Text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:textColor="@color/text_dim"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/download"
            style="@style/Button"
            android:layout_marginEnd="0dp"
            android:enabled="false"
            android:text="@string/pick_download_none" />
    </LinearLayout>
</LinearLayout>
