<?xml version="1.0" encoding="utf-8"?>
<!-- The plan's disk space at the top of the Library tab, with the same numbers as Whatbox's page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="56dp"
    android:layout_marginTop="18dp"
    android:layout_marginEnd="56dp"
    android:orientation="vertical">

    <TextView
        style="@style/Text.Section"
        android:text="@string/library_storage" />

    <ProgressBar
        android:id="@+id/storageBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="12dp"
        android:max="1000"
        android:progressDrawable="@drawable/progress_bar" />

    <TextView
        android:id="@+id/storageLine"
        style="@style/Text"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_dim"
        android:textSize="14sp" />
</LinearLayout>
