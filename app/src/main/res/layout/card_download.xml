<?xml version="1.0" encoding="utf-8"?>
<!-- One download: a small poster, the title and episode or quality, a progress bar and its status. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="340dp"
    android:layout_height="108dp"
    android:layout_marginEnd="18dp"
    android:background="@drawable/card_bg"
    android:baselineAligned="false"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="84dp"
        android:background="@drawable/poster_placeholder">

        <ImageView
            android:id="@+id/poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cardTitle"
            style="@style/Text.CardTitle"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/cardLine"
            style="@style/Text.CardLine"
            android:layout_marginTop="2dp"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="10dp"
            android:max="1000"
            android:progressDrawable="@drawable/progress_bar" />

        <TextView
            android:id="@+id/status"
            style="@style/Text.CardLine"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
