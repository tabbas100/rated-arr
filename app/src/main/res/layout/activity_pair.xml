<?xml version="1.0" encoding="utf-8"?>
<!-- First run: a short code to approve from the Mac. Nothing to type on the TV. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        style="@style/Text.Wordmark"
        android:text="@string/app_name"
        android:textColor="@color/text_dim"
        android:textSize="20sp" />

    <TextView
        style="@style/Text.Title"
        android:layout_marginTop="10dp"
        android:text="@string/pair_title"
        android:textSize="30sp" />

    <TextView
        style="@style/Text"
        android:layout_marginTop="28dp"
        android:text="@string/pair_body"
        android:textColor="@color/text_dim"
        android:textSize="17sp" />

    <TextView
        style="@style/Text"
        android:layout_marginTop="12dp"
        android:background="@drawable/code_chip"
        android:fontFamily="monospace"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:text="@string/pair_command"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/code"
        style="@style/Text"
        android:layout_marginTop="34dp"
        android:textFontWeight="600"
        android:letterSpacing="0.18"
        android:text="@string/pair_starting"
        android:textSize="64sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/spinner"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:indeterminateTint="@color/text_dim" />

        <TextView
            android:id="@+id/state"
            style="@style/Text"
            android:layout_marginStart="12dp"
            android:text="@string/pair_waiting"
            android:textColor="@color/text_dim"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/expires"
        style="@style/Text"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_faint"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/retry"
        style="@style/Button"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="0dp"
        android:text="@string/retry"
        android:visibility="gone" />
</LinearLayout>
