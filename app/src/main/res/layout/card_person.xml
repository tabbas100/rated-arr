<?xml version="1.0" encoding="utf-8"?>
<!-- An actor on the title page: a round photo over their initials, the name and the part. OK searches for them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="104dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="14dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/posterFrame"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:background="@drawable/person_circle"
        android:duplicateParentState="true"
        android:foreground="@drawable/focus_ring_oval">

        <TextView
            android:id="@+id/initials"
            style="@style/Text"
            android:layout_gravity="center"
            android:textColor="@color/text_faint"
            android:textFontWeight="300"
            android:textSize="26sp" />

        <ImageView
            android:id="@+id/poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <TextView
        android:id="@+id/name"
        style="@style/Text.CardTitle"
        android:layout_marginTop="8dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/character"
        style="@style/Text.CardLine"
        android:layout_marginTop="2dp"
        android:gravity="center" />
</LinearLayout>
