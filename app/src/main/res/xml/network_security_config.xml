<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS only, system certificate authorities only (never ones a user installed), and for Whatbox
  hosts (*.box.ca, where the gateway's HTTPS address lives) the issuing root must also be one of the
  pinned ones below. On another host, put its domain in place of box.ca, or the app falls back to the
  system's certificate checks for it. The pins are the
  public keys of Google Trust Services' roots (today's issuer), GlobalSign's root (which
  cross-signs them) and Let's Encrypt's roots as a fallback. They expire on 2027-10-26 so a
  change of certificate authority can never lock the app out for good; renew them before then.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">box.ca</domain>
        <pin-set expiration="2027-10-26">
            <pin digest="SHA-256">hxqRlPTu1bMS/0DITB1SSu0vd4u/8l8TjPgfaAp63Gc=</pin>
            <pin digest="SHA-256">Vfd95BwDeSQo+NUYxVEEIlvkOlWY2SalKK1lPhzOx78=</pin>
            <pin digest="SHA-256">QXnt2YHvdHR3tJYmQIr0Paosp6t/nggsEGD4QJZ3Q0g=</pin>
            <pin digest="SHA-256">mEflZT5enoR1FuXLgYYGqnVEoZvmf9c2bVBpiOjYQ0c=</pin>
            <pin digest="SHA-256">K87oWBWM9UZfyddvDfoxL+8lpNyoUB2ptGtn0fv6G2Q=</pin>
            <pin digest="SHA-256">C5+lpZ7tcVwmwQIMcRtPbsQtWLABXhQzejna0wHFr8M=</pin>
            <pin digest="SHA-256">diGVwiVYbubAI3RW4hB9xU8e/CH2GnkuvVFZE8zmgzI=</pin>
        </pin-set>
    </domain-config>
</network-security-config>
